node_modules
.svelte-kit
.netlify
build

# Env
.env
.env.*
!.env.example

# Local agent config — operator-specific, must not ship with the template
.claude/

# OS / editor / test output
.DS_Store
*.log
coverage
playwright-report
test-results
.lighthouseci
.reddoor-a11y
.reddoor-a11y-spec-*

# Agency process artifacts (specs/plans) and local helpers never ship in the
# template. The Blux-era ones stay tracked in reddoor-starter-blux; new specs
# and plans live in reddoor-maintenance.
/docs/superpowers/
/scratchpad/

# canonical entries from @reddoorla/maintenance sync-configs
dist/
.vitest-cache/
.tsbuildinfo

.worktrees/

# reddoor-maint match-harness: scripts + records tracked, workspace ignored
scratch-diff*/
matching/*
!matching/*.sh
!matching/*.mjs
!matching/*.md
# The pause switch. Extensionless on purpose (it is a sentinel, not a doc), so
# the whitelist above misses it — and an ignored switch is not a switch: it
# would work on one machine and be absent from every fresh clone, CI run and
# agent that most needs to see it.
!matching/PAUSED
!matching/spec-sections/
!matching/states/
matching/states/*
!matching/states/*.mjs
# derived artefacts, even where the extensions above would catch them
matching/*.log
matching/*.json
# ...except the page table itself, which is the harness's configuration and the
# one thing a fresh clone cannot reconstruct.
!matching/harness.json
matching/*.png

# end reddoor-maint match-harness
